{
  "name": "zkella-protocol",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "sdk"
  ],
  "scripts": {
    "test":        "jest --testPathPattern='tests/unit' --forceExit",
    "test:e2e":    "jest --testPathPattern='tests/e2e' --testTimeout=90000 --forceExit",
    "test:all":    "jest --forceExit",
    "build:sdk":   "npm run build --workspace=sdk",
    "typecheck":   "tsc --noEmit -p tsconfig.test.json",
    "indexer":     "node --experimental-strip-types indexer/src/main.ts"
  },
  "devDependencies": {
    "@types/jest":  "^29.5.0",
    "@types/node":  "^20.0.0",
    "jest":         "^29.7.0",
    "ts-jest":      "^29.1.0",
    "typescript":   "^5.4.0"
  },
  "dependencies": {
    "@noble/ciphers": "^0.5.0",
    "@noble/hashes":  "^1.4.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "circomlib":      "2.0.5",
    "circomlibjs":    "^0.1.7",
    "ffjavascript":   "^0.2.63",
    "snarkjs":        "^0.7.6"
  },
  "jest": {
    "preset":              "ts-jest",
    "testEnvironment":     "node",
    "moduleFileExtensions": ["ts", "js"],
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
    },
    "testTimeout": 60000,
    "testMatch": ["**/tests/**/*.test.ts"]
  }
}
