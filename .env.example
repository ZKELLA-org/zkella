# Template for local environment configuration. Copy to `.env` (or export
# these directly) and fill in real values — never commit the filled-in file.
# `.env` itself is already git-ignored; only this template is tracked.

# ── Wallet / examples (examples/*.cjs) ──────────────────────────────────────
# A funded Testnet account secret (starts with "S"), used to sign shield/
# transfer/unshield transactions in the example scripts. Never a mainnet key.
STELLAR_SECRET=

# 64 hex characters (32 bytes) deriving a deterministic ZKELLAKeys wallet.
# Prefer SPENDING_SEED_FILE below for anything other than a one-off script
# run, so the seed is generated once and persisted with mode 0600 instead of
# living in shell history / process environment.
SPENDING_SEED=
SPENDING_SEED_FILE=./demo-keys/spending_seed.hex

# Amount (in the asset's smallest unit) for examples/02-shield.cjs.
SHIELD_AMOUNT=1000

# Hex-encoded viewing-key export (see sdk/src/keys — ZKELLAKeys.exportViewingKey())
# consumed by examples/04-viewing-key-audit.cjs.
VIEWING_KEY_EXPORT=

# ── Indexer (indexer/src/, scripts/*.cjs) ───────────────────────────────────
# Base URL of a running indexer instance (see indexer/README.md).
INDEXER_URL=http://localhost:8787

# Backend selection for the indexer process itself — set DATABASE_URL for
# Postgres, or leave unset and use INDEXER_DB_PATH for a file-backed SQLite
# instance (":memory:" for ephemeral/test runs). See indexer/src/db.ts.
DATABASE_URL=
INDEXER_DB_PATH=:memory:
INDEXER_HTTP_PORT=8787
INDEXER_POLL_MS=2000
INDEXER_RATE_LIMIT_PER_MINUTE=120

# Comma-separated API keys the indexer's HTTP layer accepts for authenticated
# wallet/auditor endpoints. Leave unset only for a local, unauthenticated dev
# instance — never in anything reachable outside localhost.
INDEXER_API_KEYS=

# ── scripts/_shield_batch_bench.cjs ──────────────────────────────────────────
# Token contract to benchmark against (default: the production testnet_final
# token) and the `stellar keys` identity to sign with (default:
# zkella-testnet-deployer) — both already-funded Testnet-only values, never
# mainnet.
SHIELD_BENCH_TOKEN_ID=
SHIELD_BENCH_IDENTITY=

# ── scripts/testnet_shield_batch.cjs, scripts/testnet_scale_run.cjs ─────────
# These submit real Testnet transactions — TOKEN_ID/ASSET_ID must point at a
# contract/asset pair you control and have already approved for shielding.
TOKEN_ID=
ASSET_ID=
BATCH_SIZE=8
BATCHES=1
